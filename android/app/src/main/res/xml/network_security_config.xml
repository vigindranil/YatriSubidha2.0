<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config tlsVersions="TLSv1.2">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Optional: domain specific config -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">yatrisubidha.wb.gov.in</domain>
    </domain-config>
</network-security-config>
